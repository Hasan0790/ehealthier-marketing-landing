<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 960 1100" role="img" aria-labelledby="title desc">
  <title id="title">Synthetic physiotherapy clinical workflow sample</title>
  <desc id="desc">A synthetic eHealthier panel showing physiotherapy outcome pathways for a patient.</desc>
  <rect width="960" height="1100" fill="#f5f7f8"/>
  <rect x="0" y="0" width="960" height="72" fill="#17384f"/>
  <text x="40" y="45" font-family="Inter, Arial, sans-serif" font-size="24" font-weight="700" fill="#ffffff">eHealthier</text>
  <text x="820" y="44" font-family="Inter, Arial, sans-serif" font-size="15" fill="#d8e5e8">Synthetic sample</text>
  <rect x="34" y="104" width="892" height="142" rx="6" fill="#ffffff" stroke="#dfe8ea"/>
  <text x="66" y="145" font-family="Inter, Arial, sans-serif" font-size="16" font-weight="700" fill="#17384f">Patient in visit</text>
  <text x="66" y="184" font-family="Inter, Arial, sans-serif" font-size="34" font-weight="800" fill="#122b3f">Alex Carter</text>
  <text x="66" y="214" font-family="Inter, Arial, sans-serif" font-size="17" fill="#65757c">Physiotherapy follow-up - right knee rehabilitation</text>
  <rect x="668" y="135" width="220" height="48" rx="24" fill="#e8f5f1"/>
  <text x="705" y="166" font-family="Inter, Arial, sans-serif" font-size="16" font-weight="700" fill="#237764">PROMs due today</text>
  <text x="48" y="298" font-family="Inter, Arial, sans-serif" font-size="15" font-weight="800" fill="#687980" letter-spacing="1.8">PHYSIOTHERAPY PATHWAY</text>
  <rect x="34" y="330" width="892" height="136" rx="6" fill="#ffffff" stroke="#dfe8ea"/>
  <rect x="58" y="356" width="78" height="78" rx="6" fill="#e8f5f1"/>
  <text x="82" y="405" font-family="Inter, Arial, sans-serif" font-size="28" font-weight="800" fill="#237764">1</text>
  <text x="160" y="374" font-family="Inter, Arial, sans-serif" font-size="23" font-weight="800" fill="#122b3f">Lower limb recovery pathway</text>
  <text x="160" y="408" font-family="Inter, Arial, sans-serif" font-size="17" fill="#607179">Knee injury, return-to-function, and pain impact measures</text>
  <rect x="707" y="371" width="156" height="44" rx="22" fill="#17384f"/>
  <text x="753" y="399" font-family="Inter, Arial, sans-serif" font-size="15" font-weight="700" fill="#ffffff">Assign</text>
  <rect x="34" y="486" width="892" height="136" rx="6" fill="#ffffff" stroke="#dfe8ea"/>
  <rect x="58" y="512" width="78" height="78" rx="6" fill="#eef2fb"/>
  <text x="82" y="561" font-family="Inter, Arial, sans-serif" font-size="28" font-weight="800" fill="#4d63a4">2</text>
  <text x="160" y="530" font-family="Inter, Arial, sans-serif" font-size="23" font-weight="800" fill="#122b3f">Spine and disability pathway</text>
  <text x="160" y="564" font-family="Inter, Arial, sans-serif" font-size="17" fill="#607179">Oswestry-style disability, pain interference, and goals review</text>
  <rect x="707" y="527" width="156" height="44" rx="22" fill="#17384f"/>
  <text x="753" y="555" font-family="Inter, Arial, sans-serif" font-size="15" font-weight="700" fill="#ffffff">Assign</text>
  <rect x="34" y="642" width="892" height="136" rx="6" fill="#ffffff" stroke="#dfe8ea"/>
  <rect x="58" y="668" width="78" height="78" rx="6" fill="#fff3e2"/>
  <text x="82" y="717" font-family="Inter, Arial, sans-serif" font-size="28" font-weight="800" fill="#c17422">3</text>
  <text x="160" y="686" font-family="Inter, Arial, sans-serif" font-size="23" font-weight="800" fill="#122b3f">Goal-based rehab check-in</text>
  <text x="160" y="720" font-family="Inter, Arial, sans-serif" font-size="17" fill="#607179">Patient-specific functional scale and confidence to self-manage</text>
  <rect x="707" y="683" width="156" height="44" rx="22" fill="#17384f"/>
  <text x="753" y="711" font-family="Inter, Arial, sans-serif" font-size="15" font-weight="700" fill="#ffffff">Assign</text>
  <rect x="34" y="826" width="892" height="190" rx="6" fill="#ffffff" stroke="#dfe8ea"/>
  <text x="66" y="870" font-family="Inter, Arial, sans-serif" font-size="20" font-weight="800" fill="#122b3f">Recent outcome signal</text>
  <text x="66" y="908" font-family="Inter, Arial, sans-serif" font-size="16" fill="#607179">LEFS improved from 43 to 58 over 4 weeks</text>
  <rect x="66" y="940" width="780" height="14" rx="7" fill="#e6ecef"/>
  <rect x="66" y="940" width="512" height="14" rx="7" fill="#4eb39c"/>
  <text x="66" y="986" font-family="Inter, Arial, sans-serif" font-size="15" font-weight="700" fill="#237764">Suggested next step: review return-to-running goals</text>
</svg>
